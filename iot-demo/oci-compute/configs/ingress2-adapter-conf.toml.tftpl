# Rendered by templatefile() -> written to disk by device-b cloud-init.
# Vars: zpr_dir, node_addr. node_addr = zpr-core's PRIVATE IP:5000 (across the subnet).
# ingress2 is the BLOCKED path — ZPR policy denies it at the node.
# No zpr_addr/tun_if: DYNAMIC ZPR address + TUN from the node (needs CAP_NET_ADMIN).
[global]
ca_file = "${zpr_dir}/authority/auth-ca.crt"
certificate_file = "${zpr_dir}/ingress2/ingress2-noise.crt"
private_key_file = "${zpr_dir}/ingress2/ingress2-noise.key"

[adapter]
node_addr = "${node_addr}"
node_public_key_file = "${zpr_dir}/node/node-noise-pub.pem"
bootstrap_key = "${zpr_dir}/ingress2/ingress2-private-key.pem"
