# Where your ZPR source checkouts live. Copy to sources.env and edit:
#
#   cp sources.env.example sources.env
#
# sources.env is gitignored and sourced by build-in-ol9.sh and vs-admin.sh.
# It only sets what is unset, so an exported env var still wins for one-offs:
#
#   ZPR_VS_SRC=~/src/zpr-vs-experiment ./vs-admin.sh actors
#
# NOTE: not sourced by lib.sh (which runs `tofu output` at source time and so
# needs deployed infrastructure), nor by docker-compose — see setup/egress/.env.

# --- split-repo layout (one repo per component) ---
: "${ZPR_CORE_SRC:=$HOME/src/zpr-core}"                # builds ph
: "${ZPR_VS_SRC:=$HOME/src/zpr-visaservice}"           # builds vs, vsapikey, vs-admin
: "${ZPR_COMPILER_SRC:=$HOME/src/zpr-compiler}"        # builds zplc (manual policy compile)

# --- monorepo layout: comment out the block above and use these instead ---
# : "${ZPR_CORE_SRC:=/home/othomas/zpr/core}"
# : "${ZPR_VS_SRC:=/home/othomas/zpr/visaservice}"
# : "${ZPR_COMPILER_SRC:=/home/othomas/zpr/compiler}"

# OL9 build output (ph/vs/vsapikey). Deliberately outside every source tree.
: "${ZPR_BUILD_DIR:=$HOME/.cache/zpr-oci-build}"

export ZPR_CORE_SRC ZPR_VS_SRC ZPR_COMPILER_SRC ZPR_BUILD_DIR
