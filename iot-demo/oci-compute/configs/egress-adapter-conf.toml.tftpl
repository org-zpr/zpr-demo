# Rendered by templatefile() -> written to disk by zpr-core cloud-init.
# Vars: zpr_dir, node_addr. Egress adapter is co-located with the node -> 127.0.0.1:5000.
# No zpr_addr/tun_if: it gets a DYNAMIC ZPR address + TUN from the node (needs CAP_NET_ADMIN).
[global]
ca_file = "${zpr_dir}/authority/auth-ca.crt"
certificate_file = "${zpr_dir}/egress/egress-noise.crt"
private_key_file = "${zpr_dir}/egress/egress-noise.key"

[adapter]
node_addr = "${node_addr}"
node_public_key_file = "${zpr_dir}/node/node-noise-pub.pem"
bootstrap_key = "${zpr_dir}/egress/egress-private-key.pem"
